# ====================================
# CRM-AI Environment Variables
# ====================================
# Copy this file to .env.local and fill in your values

# ====================================
# REQUIRED - Supabase Configuration
# ====================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ====================================
# OPTIONAL - Supabase Admin (for server-side operations)
# ====================================
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ====================================
# OPTIONAL - AI Providers
# ====================================
# OpenAI - For AI lead enrichment, summaries, auto-tagging
OPENAI_API_KEY=sk-...

# Anthropic Claude - Alternative AI provider
ANTHROPIC_API_KEY=sk-ant-...

# ====================================
# OPTIONAL - OAuth Providers
# ====================================
# Google OAuth - For Google Sign-In and Calendar integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth - Configured in Supabase Dashboard

# ====================================
# OPTIONAL - Stripe (for paid features)
# ====================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ====================================
# OPTIONAL - Email (for notifications)
# ====================================
RESEND_API_KEY=re_...

# ====================================
# OPTIONAL - Application URLs
# ====================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ====================================
# OPTIONAL - External APIs (Lead Enrichment)
# ====================================
APOLLO_API_KEY=
CLEARBIT_API_KEY=
HUNTER_API_KEY=
